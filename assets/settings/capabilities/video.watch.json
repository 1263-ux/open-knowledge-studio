{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "video.watch",
  "version": "1.0.0",
  "accepts": {"mime_types": ["video/mp4", "video/webm", "video/quicktime", "video/x-matroska"], "extensions": [".mp4", ".webm", ".mov", ".mkv", ".avi"], "source_types": ["local", "feishu_base"]},
  "command": ["{watch_python}", "{adapter}", "watch", "{input}", "--output", "{output}"],
  "required_environment": [
    {"name": "ffmpeg", "kind": "executable", "required": true, "probe": ["{ffmpeg}", "-version"]},
    {"name": "watch_python", "kind": "python", "required": true, "probe": ["{watch_python}", "--version"]}
  ],
  "produces": [
    {"kind": "transcript", "path": "derived/transcript.md", "schema": null},
    {"kind": "keyframes", "path": "assets/frames/", "schema": null},
    {"kind": "ocr", "path": "derived/ocr.jsonl", "schema": null}
  ],
  "license": "See Watch Skill, FFmpeg, OCR, ASR and model licenses before redistribution",
  "limitations": ["Platform subtitles are preferred but not always available", "No-subtitle ASR and frame OCR may be partial"],
  "network_policy": "offline"
}
