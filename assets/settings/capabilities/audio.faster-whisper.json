{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "audio.faster-whisper",
  "version": "1.0.0",
  "accepts": {"mime_types": ["audio/mpeg", "audio/wav", "audio/mp4", "audio/aac", "audio/flac", "audio/ogg"], "extensions": [".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg"], "source_types": ["local", "feishu_base"]},
  "command": ["{watch_python}", "{adapter}", "watch", "{input}", "--output", "{output}", "--transcript-only"],
  "required_environment": [
    {"name": "faster-whisper", "kind": "package", "required": true, "probe": ["{watch_python}", "-c", "import faster_whisper"]},
    {"name": "ffmpeg", "kind": "executable", "required": true, "probe": ["{ffmpeg}", "-version"]},
    {"name": "ASR model", "kind": "model", "required": true, "probe": null}
  ],
  "produces": [
    {"kind": "asr", "path": "derived/transcript.md", "schema": null},
    {"kind": "timestamped_evidence", "path": "evidence.jsonl", "schema": "raw-multimodal/v0.2"}
  ],
  "license": "See faster-whisper, CTranslate2, FFmpeg and selected model licenses before redistribution",
  "limitations": ["Accuracy depends on language, audio quality and the selected model", "Speaker diarization is not guaranteed"],
  "network_policy": "offline"
}
