{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "pdf.mineru",
  "version": "1.0.0",
  "accepts": {"mime_types": ["application/pdf"], "extensions": [".pdf"], "source_types": ["local", "feishu_base"]},
  "command": ["{mineru_python}", "-m", "mineru", "-p", "{input}", "-o", "{workdir}", "-b", "{backend}", "-m", "{method}"],
  "required_environment": [
    {"name": "mineru_python", "kind": "python", "required": true, "probe": ["{mineru_python}", "-m", "mineru", "--version"]}
  ],
  "produces": [
    {"kind": "markdown", "path": "derived/document.md", "schema": null},
    {"kind": "layout_evidence", "path": "evidence.jsonl", "schema": "raw-multimodal/v0.2"},
    {"kind": "image_assets", "path": "assets/", "schema": null}
  ],
  "license": "See installed MinerU package and model licenses before redistribution",
  "limitations": ["Scanned pages depend on OCR quality", "Formula and reading-order fidelity require sample-based validation"],
  "network_policy": "offline"
}
