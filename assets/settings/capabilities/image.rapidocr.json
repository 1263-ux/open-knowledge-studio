{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "image.rapidocr",
  "version": "1.0.0",
  "accepts": {"mime_types": ["image/png", "image/jpeg", "image/webp", "image/bmp", "image/tiff"], "extensions": [".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tiff"], "source_types": ["local", "browser", "obsidian", "feishu_base"]},
  "command": ["{watch_python}", "{adapter}", "image", "{input}", "--output", "{output}"],
  "required_environment": [
    {"name": "RapidOCR", "kind": "package", "required": true, "probe": ["{watch_python}", "-c", "import rapidocr_onnxruntime"]}
  ],
  "produces": [
    {"kind": "ocr", "path": "derived/ocr.json", "schema": null},
    {"kind": "markdown", "path": "content.md", "schema": null},
    {"kind": "evidence", "path": "evidence.jsonl", "schema": "raw-multimodal/v0.2"}
  ],
  "license": "See installed RapidOCR runtime and model licenses before redistribution",
  "limitations": ["OCR does not imply semantic visual understanding", "Low-resolution and stylized text may be partial"],
  "network_policy": "offline"
}
