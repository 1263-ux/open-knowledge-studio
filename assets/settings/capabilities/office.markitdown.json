{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "office.markitdown",
  "version": "1.0.0",
  "accepts": {"mime_types": ["application/vnd.openxmlformats-officedocument.presentationml.presentation", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/html", "text/plain", "text/csv"], "extensions": [".pptx", ".docx", ".xlsx", ".html", ".txt", ".csv"], "source_types": ["local", "feishu_base"]},
  "command": ["{document_python}", "{adapter}", "markitdown", "{input}", "--output", "{output}"],
  "required_environment": [
    {"name": "MarkItDown", "kind": "package", "required": true, "probe": ["{document_python}", "-c", "import markitdown"]}
  ],
  "produces": [
    {"kind": "markdown", "path": "content.md", "schema": null},
    {"kind": "embedded_assets", "path": "assets/", "schema": null}
  ],
  "license": "See installed MarkItDown package and transitive parser licenses",
  "limitations": ["Word and spreadsheet real-sample acceptance is incomplete", "Complex slide layout may need original media review"],
  "network_policy": "offline"
}
