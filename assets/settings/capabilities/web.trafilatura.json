{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "web.trafilatura",
  "version": "1.0.0",
  "accepts": {"mime_types": ["text/html"], "extensions": [".html"], "source_types": ["feishu_base", "browser", "obsidian"]},
  "command": ["{python}", "{web_adapter}", "{source_uri}", "--output", "{output}"],
  "required_environment": [
    {"name": "Trafilatura", "kind": "package", "required": true, "probe": ["{python}", "-c", "import trafilatura"]}
  ],
  "produces": [
    {"kind": "markdown", "path": "content.md", "schema": null},
    {"kind": "html_snapshot", "path": "source/page.html", "schema": null},
    {"kind": "evidence", "path": "evidence.jsonl", "schema": "raw-multimodal/v0.2"}
  ],
  "license": "See installed Trafilatura package and parser licenses",
  "limitations": ["Dynamic or authenticated pages require the separate web.browser-snapshot capability", "Remote images are not guaranteed to be localized"],
  "network_policy": "public_http"
}
