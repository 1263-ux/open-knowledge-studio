{
  "schema_version": "oks-capability-manifest/v0.1",
  "capability": "web.browser-snapshot",
  "version": "0.1.0",
  "accepts": {"mime_types": ["text/html"], "extensions": [".html"], "source_types": ["browser", "feishu_base"]},
  "command": ["{studio_python}", "{worker}", "complete-browser", "--record-id", "{record_id}", "--snapshot-dir", "{snapshot_dir}"],
  "required_environment": [
    {"name": "User-authorized browser", "kind": "browser", "required": true, "probe": []},
    {"name": "MarkItDown", "kind": "package", "required": true, "probe": ["{document_python}", "-c", "import markitdown"]}
  ],
  "produces": [
    {"kind": "markdown", "path": "content.md", "schema": null},
    {"kind": "rendered_html", "path": "source/primary.html", "schema": null},
    {"kind": "browser_screenshot", "path": "assets/browser-screenshot.png", "schema": null},
    {"kind": "resource_manifest", "path": "derived/browser-snapshot.json", "schema": null}
  ],
  "license": "Source page license and browser/runtime licenses apply",
  "limitations": ["Only visible rendered DOM is captured", "Cross-origin subresources are inventoried but not automatically mirrored", "Authentication and CAPTCHA require explicit user action"],
  "network_policy": "user_authorized_browser"
}
