[
  {
    "name": "curl",
    "level": 0,
    "description": "HTTP fetch — web articles, API endpoints",
    "check_cmd": "which curl",
    "install_hint": "preinstalled on most systems; macOS: brew install curl, Debian/Ubuntu: apt install curl",
    "modalities": [
      "url:http",
      "url:https"
    ],
    "raw_subdir": "articles"
  },
  {
    "name": "pdftotext",
    "level": 0,
    "description": "PDF → text extraction",
    "check_cmd": "which pdftotext",
    "install_hint": "macOS: brew install poppler, Debian/Ubuntu: apt install poppler-utils, Windows: choco install poppler",
    "modalities": [
      "pdf"
    ],
    "raw_subdir": "papers"
  },
  {
    "name": "oks-video",
    "level": 1,
    "description": "Video → timestamped transcript + frames + OCR evidence Raw Bundle",
    "check_cmd": "oks-connector --version",
    "install_hint": "oks capability install watch --yes",
    "command": "oks-connector watch <input> --output <bundle_dir>",
    "modalities": [
      "mp4",
      "mov",
      "avi",
      "mkv",
      "webm"
    ],
    "raw_subdir": "videos",
    "json_protocol": true,
    "output_contract": "raw-multimodal/v0.2"
  },
  {
    "name": "oks-audio",
    "level": 1,
    "description": "Audio → timestamped ASR transcript Raw Bundle",
    "check_cmd": "oks-connector --version",
    "install_hint": "oks capability install watch --yes",
    "command": "oks-connector watch <input> --output <bundle_dir> --transcript-only",
    "modalities": [
      "mp3",
      "wav",
      "m4a",
      "flac",
      "aac",
      "ogg"
    ],
    "raw_subdir": "audio",
    "json_protocol": true,
    "output_contract": "raw-multimodal/v0.2"
  },
  {
    "name": "oks-image",
    "level": 1,
    "description": "Image → OCR text + confidence + bounding-box evidence Raw Bundle",
    "check_cmd": "oks-connector --version",
    "install_hint": "oks capability install watch --yes",
    "command": "oks-connector image <input> --output <bundle_dir>",
    "modalities": [
      "png",
      "jpg",
      "jpeg",
      "webp",
      "bmp"
    ],
    "raw_subdir": "misc",
    "json_protocol": true,
    "output_contract": "raw-multimodal/v0.2"
  },
  {
    "name": "oks-document",
    "level": 1,
    "description": "Office document → Markdown + embedded-media evidence Raw Bundle",
    "check_cmd": "oks-connector --version",
    "install_hint": "oks capability install document --yes",
    "command": "oks-connector markitdown <input> --output <bundle_dir>",
    "modalities": [
      "docx",
      "pptx"
    ],
    "raw_subdir": "papers",
    "json_protocol": true,
    "output_contract": "raw-multimodal/v0.2"
